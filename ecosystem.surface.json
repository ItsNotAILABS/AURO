    "logical_channel_contract": "auro.pocket-channel-contract.v1",
    "physical_frequency_model": "mesie.edge.hz_ladder"
  },
  "logical_channels": [
    "intel@5",
    "model@6",
    "proof@8",
    "recovery@11"
  ],
  "produces": [
    "nexus.telemetry.v1",
    "nexus.health.v1",
    "nexus.release-evidence.v1",
    "nexus.artifact.v1",
    "nexus.model-council.v1",
    "nexus.sovereignty-profile.v1"
