  "consumes": [
    "nexus.task.v1",
    "nexus.budget.v1",
    "nexus.context-pack.v1",
    "nexus.policy-decision.v1",
    "auro.model-family.v2"
  ],
  "family_lanes": [
    "Auro-156K",
    "Auro-250M",
    "Auro-500M",
    "Auro-2B",
    "Auro-4B",
    "Auro-8B",
    "Auro-14B",
    "Auro-100B"
  ],
  "limits": {
    "model_self_authority": false,
    "external_side_effects": false,
    "benchmark_claim_requires_artifact": true,
    "private_reasoning_export": false,
    "architecture_is_checkpoint_evidence": false,
    "accepted_context_is_dense_attention": false,
    "named_specialist_is_trained_checkpoint": false,
    "logical_hz_is_physical_radio_claim": false
