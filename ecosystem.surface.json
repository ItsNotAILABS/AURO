{
  "schema": "nexus.capability.v1",
  "component": "auro-mesie-runtime",
  "repository": "ItsNotAILABS/AURO",
  "role": "spectral-intelligence-model-runtime-plane",
  "research_corpus": "medina.corpus-architectura.v2@2.1.0",
  "actions": [
    "model.capabilities",
    "model.sdk.describe",
    "model.cli.describe",
    "model.channel.describe",
    "model.infer.spectral",
    "model.embed",
    "model.atomic.compute",
    "model.council.compute",
    "model.sovereignty.profile",
    "model.benchmark",
    "model.health",
    "model.release_evidence"
  ],
  "risk_tiers": {
    "model.capabilities": "read",
    "model.sdk.describe": "read",
    "model.cli.describe": "read",
    "model.channel.describe": "read",
    "model.infer.spectral": "compute",
    "model.embed": "compute",
    "model.atomic.compute": "compute-bounded",
    "model.council.compute": "compute-bounded",
    "model.sovereignty.profile": "read-evidence",
    "model.benchmark": "compute-bounded",
    "model.health": "read",
    "model.release_evidence": "read"
  },
  "interfaces": {
    "python_sdk": "mesie.auro_sdk:AuroSDK",
    "cli": "auro",
